# ── Neo4j ─────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=turret_change_me_in_prod

# ── API ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# ── Redis (for Celery worker) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Reproducibility ────────────────────────────────────────────────────────
TURRET_SEED=42

# ── ExifTool path ─────────────────────────────────────────────────────────
EXIFTOOL_PATH=/usr/bin/exiftool

# ── Tika server ────────────────────────────────────────────────────────────
TIKA_SERVER_JAR=~/.tika/tika-server.jar

# ── Ed25519 signing key paths ──────────────────────────────────────────────
# Generate with: python scripts/gen_keys.py
SIGNING_KEY_PATH=config/keys/signing_key.pem
VERIFY_KEY_PATH=config/keys/verify_key.pem

# ── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
